rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    function isOwnerOnCreate() {
      return isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
    }

    function ownerIdUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerOnCreate();
      allow update: if isOwner() && ownerIdUnchanged();
      allow delete: if isOwner();
    }

    match /properties/{propertyId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerOnCreate();
      allow update: if isOwner() && ownerIdUnchanged();
      allow delete: if isOwner();
    }

    match /contracts/{contractId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerOnCreate();
      allow update: if isOwner() && ownerIdUnchanged();
      allow delete: if isOwner();
    }

    match /settings/{userId} {
      allow read: if isAuthenticated() && userId == request.auth.uid;
      allow create: if isAuthenticated()
        && userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && userId == request.auth.uid
        && resource.data.ownerId == request.auth.uid
        && ownerIdUnchanged();
      allow delete: if isAuthenticated() && userId == request.auth.uid;
    }
  }
}
